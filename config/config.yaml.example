# Jarvis Topic Manager — Configuration
# install.sh writes /etc/topic-manager/config.yaml from this file, filling in
# the values below from its prompts or --ldap-* flags. To prepare one by hand,
# copy it there and replace every <placeholder>. There are NO built-in
# directory defaults: install.sh, the upgrade and the application all refuse
# to use a config whose auth.ldap_server, ldap_base_dn or ldap_domain is
# missing or still a <placeholder>.
# Copyright (c) 2025-2026 James Rodman. All Rights Reserved.

server:
  host: 127.0.0.1
  port: 5001
  # Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
  secret_key: "CHANGE_ME_GENERATE_A_RANDOM_SECRET"

auth:
  # LDAPS URL of a domain controller / directory server, e.g.
  # "ldaps://dc1.example.org:636". Plain ldap:// is not supported for use.
  ldap_server: "<ldaps://directory-host:636>"
  # The UPN suffix users sign in with: <user>@<ldap_domain>, e.g. "example.org".
  ldap_domain: "<directory-domain>"
  # Where users are searched for, e.g. "DC=example,DC=org".
  ldap_base_dn: "<base-dn>"
  # Path to PEM CA bundle for LDAPS certificate validation.
  # Leave blank to use the system trust store (/etc/ssl/certs/ca-certificates.crt).
  # Point to your internal CA if it is not in the system store.
  ldap_ca_cert: ""
  # Service account for LDAP searches (read-only, Domain Users sufficient).
  # When set, auth uses a two-phase bind: service account searches for the user,
  # then the user's own DN + password is verified. Recommended over direct user bind.
  # Leave ldap_bind_dn blank ("") to bind directly as the signing-in user.
  # e.g. "CN=svc-topic-manager,OU=Service Accounts,DC=example,DC=org"
  ldap_bind_dn: ""
  ldap_bind_password: "CHANGE_ME"
  # Full DN of the group whose members may sign in, e.g.
  # "CN=Kafka-Admins,OU=Groups,DC=example,DC=org". Blank = any directory account.
  required_group: "<required-group-dn>"

# NOTE: cluster profiles are NOT in this file any more.
#
# As of v1.0.4 they live in /etc/topic-manager/clusters.d/clusters.yaml, which
# the application owns and writes through the Cluster Builder in Settings. See
# config/clusters.yaml.example. This file stays root-owned 0640
# root:topic-manager and the application can only READ it, so an add/edit of a
# cluster can never reach secret_key or ldap_bind_password.
#
# The upgrade moves an existing clusters: block out of here automatically and
# idempotently; nothing needs to be done by hand.

session:
  # Minutes of INACTIVITY before the session ends. The browser arms its own
  # idle timer from this value (served on login and whoami), warns at 60
  # seconds remaining and signs the user out when it reaches zero, so the
  # number here is the one a person actually experiences.
  #
  # Background tab refreshes do NOT count as activity (they send
  # X-TM-Background: 1). Before v1.0.6 they did, which meant an open tab
  # renewed its own session every 30 seconds and this setting could only
  # ever expire a CLOSED one.
  timeout_minutes: 15
  # Maximum simultaneous sessions per user. 0 = unlimited.
  # When the limit is reached the login attempt is rejected with HTTP 429.
  max_concurrent: 5

audit:
  db_path: "/opt/topic-manager/data/tm.db"

logging:
  log_level: "INFO"    # DEBUG / INFO / WARNING / ERROR
  # Set syslog_enabled: true to send auth events and errors to the local
  # syslog daemon (/dev/log, facility daemon). Forwarding them off the host is
  # the host's own syslog configuration (remote syslog is planned for v1.2.0).
  syslog_enabled: false
