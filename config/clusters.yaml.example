# Jarvis Topic Manager — Cluster Profiles
# Copyright (c) 2025-2026 James Rodman. All Rights Reserved.
#
# Installed to /etc/topic-manager/clusters.d/clusters.yaml,
# owned topic-manager:topic-manager, mode 0640.
#
# This is the ONE file the application writes. It lives in its own directory so
# that the directory can be app-writable (atomic replace needs to create a temp
# file beside the target) while /etc/topic-manager itself stays
# root:topic-manager 0750 — the application can read config.yaml and can
# neither modify nor unlink it.
#
# Edit it by hand if you like: every gunicorn worker re-reads it when its
# inode/size/mtime changes, so no restart is needed. The normal route is the
# Cluster Builder in Settings, which validates and writes it atomically.
#
# TLS material: ssl_cafile / ssl_certfile / ssl_keyfile are absolute paths
# under /opt/topic-manager/data/cluster-certs/, generated by the Cluster
# Builder from PEM content you upload. A path anywhere else is REFUSED on load
# and the profile is disabled — a cluster profile is not a way to make the
# service read an arbitrary file and report the error back to you.

clusters:
  - id: "bare-metal"
    name: "Bare Metal — Legacy Jarvis"
    bootstrap_servers: "broker1.int.crypticlight.com:9092,broker2.int.crypticlight.com:9092,broker3.int.crypticlight.com:9092"
    security_protocol: "PLAINTEXT"
    active: true

  - id: "k8s-jarvis"
    name: "K8s Jarvis"
    bootstrap_servers: "192.168.202.131:9094,192.168.202.132:9094,192.168.202.133:9094"
    security_protocol: "SSL"
    # Uploaded through the Cluster Builder; the filename is generated server-side.
    ssl_cafile: "/opt/topic-manager/data/cluster-certs/k8s-jarvis-ca-4f2ab1c9.pem"
    active: false

  # SASL_SSL example. sasl_password is write-only over the API: it is accepted,
  # stored here for librdkafka, and never returned by any route or written to
  # the audit log.
  # - id: "secured"
  #   name: "Secured Cluster"
  #   bootstrap_servers: "kafka1.example.com:9093"
  #   security_protocol: "SASL_SSL"
  #   sasl_mechanism: "SCRAM-SHA-512"
  #   sasl_username: "topic-manager"
  #   sasl_password: "CHANGE_ME"
  #   ssl_cafile: "/opt/topic-manager/data/cluster-certs/secured-ca-9d13ee07.pem"
  #   active: false
