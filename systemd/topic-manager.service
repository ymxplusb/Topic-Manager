[Unit]
Description=Jarvis Topic Manager (gunicorn)
After=network.target topic-manager.socket
Wants=network-online.target
# v1.2.0: gunicorn listens ONLY on the Unix socket topic-manager.socket holds
# (0660 topic-manager:www-data); no TCP port. See that unit for why.
Requires=topic-manager.socket

[Service]
Type=exec
User=topic-manager
Group=topic-manager
WorkingDirectory=/opt/topic-manager
Environment="TM_CONFIG=/etc/topic-manager/config.yaml"
# The cluster profiles the Cluster Builder writes. Declared here so the one
# path the service uses is stated in exactly one place, and so it matches the
# ReadWritePaths entry below.
Environment="TM_CLUSTERS_DIR=/etc/topic-manager/clusters.d"
Environment="TM_CLUSTER_CERT_DIR=/opt/topic-manager/data/cluster-certs"
# --bind is IGNORED while the socket unit hands gunicorn its socket
# (LISTEN_FDS). It is here so that a gunicorn started WITHOUT it fails closed:
# it would bind its own socket, --umask 0o117 makes that 0660
# topic-manager:topic-manager, and nginx (www-data) could not connect — never
# a TCP port, never a socket anyone else can open.
ExecStart=/opt/topic-manager/venv/bin/gunicorn \
    --workers 4 \
    --bind unix:/run/topic-manager/gunicorn.sock \
    --umask 0o117 \
    --timeout 90 \
    --worker-tmp-dir /tmp \
    --max-requests 1000 \
    --max-requests-jitter 100 \
    --access-logfile /opt/topic-manager/logs/access.log \
    --error-logfile  /opt/topic-manager/logs/error.log \
    --capture-output \
    "tm.app:create_app()"
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=topic-manager

# Hardening
# v1.1.0: every file the service creates is private to it unless the code
# sets a mode on purpose (clusters.yaml is chmod 0640 explicitly). This is what
# keeps the audit database and its -wal/-journal siblings 0600 even if
# something other than tm/models.py ever creates them.
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# /etc/topic-manager/clusters.d ONLY — never /etc/topic-manager itself.
# Measured 2026-08-30: a directory this user can write is a directory in
# which it can UNLINK a root-owned 0600 file, and config.yaml holds
# secret_key, the LDAP bind password and required_group. DAC still holds
# inside the mount namespace, so the parent staying root:topic-manager 0750
# is what actually protects it; this entry only opens the subdirectory.
ReadWritePaths=/opt/topic-manager/data /opt/topic-manager/logs /tmp /etc/topic-manager/clusters.d

[Install]
WantedBy=multi-user.target
