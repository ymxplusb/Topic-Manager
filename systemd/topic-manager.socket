[Unit]
Description=Jarvis Topic Manager — the gunicorn socket (nginx is its only client)
Documentation=file:/etc/nginx/sites-available/topic-manager

# v1.2.0 (owner ruling 2026-09-29; adversary F-05, sec-review TM-SEC-003).
# Until v1.2.0 gunicorn listened on 127.0.0.1:5001, and ANY local process
# could talk to it directly: past nginx's sign-in and API rate limits, its
# body-size and timeout limits and its TLS, and with an X-Forwarded-For of
# its choosing, which ProxyFix (x_for=1) takes as the client address in every
# session row and audit record. A Unix socket that only nginx and the service
# account can open closes both.
#
# WHY systemd OWNS THE SOCKET (and not gunicorn under a RuntimeDirectory):
# gunicorn chowns a socket it binds itself to its OWN uid and gid
# (gunicorn/sock.py UnixSocket.bind, util.chown(addr, conf.uid, conf.gid)),
# so it can never be group www-data without putting the service account in
# www-data or nginx in topic-manager — and the second would let nginx read
# config.yaml (root:topic-manager 0640). systemd creates it here, 0660
# topic-manager:www-data, and hands it to gunicorn (socket activation,
# LISTEN_FDS); gunicorn then binds nothing.

[Socket]
ListenStream=/run/topic-manager/gunicorn.sock
SocketUser=topic-manager
SocketGroup=www-data
SocketMode=0660
DirectoryMode=0755
# One gunicorn for every connection. A connection while the service is
# stopped STARTS it (socket activation), so install.sh and the upgrade stop
# this unit as well as the service while they replace the application.
Accept=no

[Install]
WantedBy=sockets.target
