# This project is deployed to Ubuntu and its shell scripts are executed there.
# A carriage return at the end of a `set -o pipefail` line becomes
# `set: pipefail: invalid option name` AT RUN TIME on the target host, and
# `bash -n` does not catch it - it is a valid script containing an option name
# that happens to end in a control character.
#
# Every tracked file here is stored with LF today, measured with
# `git ls-files --eol` against the INDEX rather than by reading a working tree
# (a Windows clone with core.autocrlf=true shows CRLF for everything and says
# nothing about what is committed). This file keeps it that way after the next
# edit on a Windows box, and the release pipeline refuses a committed CR on
# every tag either way.
* text=auto eol=lf

*.sh   text eol=lf
*.bash text eol=lf
*.py   text eol=lf
*.csv  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

*.png  binary
*.jpg  binary
*.ico  binary
*.docx binary
*.pdf  binary

# Never shipped (v1.1.0). `git archive` builds the offline bundle
# (prepare-offline.sh) and the CI release tarball, and these are this
# repository's own process records: the agent contract and the work orders
# carry production host names and addresses. tools/check-env-neutral.sh
# --bundle refuses a bundle that contains them anyway.
# The directory itself AND everything in it: with only the /** form, git
# archive still emits the empty directory entries.
.claude      export-ignore
.claude/**   export-ignore
.work        export-ignore
.work/**     export-ignore
.github      export-ignore
.github/**   export-ignore
# The CI definition names the site's CI namespace; it runs from the clone,
# never from an archive, so it does not ship either (round 2).
.gitlab-ci.yml export-ignore
# Release evidence (v1.3.0): docs/releases/<version>/ holds scanner and
# clean-room output (dast*.json, install-findings.json) for the release
# pipeline's `guides` job, which reads it from the CLONE, not the tarball. It
# names the throwaway hosts it was taken on, so it never lands on a customer
# host: not in the offline bundle, not in the CI release tarball.
# tools/check-env-neutral.sh --bundle refuses a bundle carrying it anyway.
docs/releases      export-ignore
docs/releases/**   export-ignore
